@using DiffPlex.DiffBuilder.Model;

@if (!string.IsNullOrEmpty(Model.Text)) {

    if (Model.Type == ChangeType.Modified) {
        foreach (DiffPiece character in Model.SubPieces) {
            if (character.Type == ChangeType.Imaginary) { continue; }

            <span class="@GetDiffPieceClass(character) @GetWrapClass()">@((MarkupString)character.Text)</span>
        }

    } else {
        <div class="mb-0 @GetWrapClass()">@Model.Text</div>

    }
}

@code {
    [Parameter] public DiffPiece Model { get; set; }

    [Parameter] public bool WordWrap { get; set; }


    private string GetWrapClass() {
        if (WordWrap)
            return "pre-wrap";
        return "pre";
    }

    private string GetDiffPieceClass(DiffPiece character) {
        return $"diff-{character.Type.ToString().ToLower()}-piece";
    }
}
