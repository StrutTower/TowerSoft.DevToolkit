
<button type="button" @onclick="SetTheme" class="btn btn-outline-info btn-outline-text @(CurrentTheme == Theme.ToLower() ? "active" : "")">
    @if (Theme == "Light") {
        <IconSun />
    } else if (Theme == "Dark") {
        <IconMoon />
    } else {
        <IconSunMoon />
    }
    @Theme
</button>